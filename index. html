#nm,#nurl,#ncode{width:100%;padding:9px 11px;border-radius:10px;border:1.5px solid #334155;background:#1e293b;color:#fff;font:600 16px 'Fredoka';outline:none}#nm:focus{border-color:var(--amber)}
h3{margin:14px 0 6px;font-size:13px;color:#cbd5e1}
</style></head>
