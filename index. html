<script>
if(!CanvasRenderingContext2D.prototype.roundRect)CanvasRenderingContext2D.prototype.roundRect=function(x,y,w,h){this.rect(x,y,w,h)};
const $=id=>document.getElementById(id),rnd=a=>a[Math.floor(Math.random()*a.length)];
/* ---------- audio ---------- */
let AC=null,OUT=null,REV=null;
function ac(){if(!AC){AC=new(window.AudioContext||window.webkitAudioContext)();const c=AC.createDynamicsCompressor();c.threshold.value=-14;c.ratio.value=6;const m=AC.createGain();m.gain.value=.9;c.connect(m);m.connect(AC.destination);OUT=c;
 const len=Math.floor(AC.sampleRate*.5),b=AC.createBuffer(2,len,AC.sampleRate);for(let ch=0;ch<2;ch++){const d=b.getChannelData(ch);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,3)}
 REV=AC.createConvolver();REV.buffer=b;const rg=AC.createGain();rg.gain.value=.22;REV.connect(rg);rg.connect(OUT)}
 if(AC.state==='suspended')AC.resume();return AC}
function env(node,t,vol,dur,atk){const g=AC.createGain();g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(vol,t+(atk||.004));g.gain.exponentialRampToValueAtTime(.0001,t+dur);node.connect(g);g.connect(OUT);g.connect(REV)}
function tone(type,f1,f2,dur,vol=.5,delay=0){try{ac();const t=AC.currentTime+delay,o=AC.createOscillator();o.type=type;o.frequency.setValueAtTime(f1,t);o.frequency.exponentialRampToValueAtTime(Math.max(20,f2),t+dur);env(o,t,vol,dur);o.start(t);o.stop(t+dur+.05)}catch(e){}}
function noise(type,f1,f2,dur,vol=.5,delay=0,q=1){try{ac();const t=AC.currentTime+delay,n=Math.floor(AC.sampleRate*dur),b=AC.createBuffer(1,n,AC.sampleRate),d=b.getChannelData(0);for(let i=0;i<n;i++)d[i]=Math.random()*2-1;
 const s=AC.createBufferSource();s.buffer=b;const f=AC.createBiquadFilter();f.type=type;f.Q.value=q;f.frequency.setValueAtTime(f1,t);f.frequency.exponentialRampToValueAtTime(f2,t+dur);s.connect(f);env(f,t,vol,dur,.01);s.start(t)}catch(e){}}
const pv=()=>.92+Math.random()*.18;
const SFX={
 punch:()=>{noise('bandpass',500,2600,.14,.5,0,1.5);tone('sine',260*pv(),120,.08,.15)},
 hit:()=>{const p=pv();tone('sine',150*p,38,.22,1.1);noise('lowpass',2400,200,.14,.9);tone('square',1100*p,180,.05,.25);noise('highpass',3000,6000,.05,.25)},
 block:()=>{const p=pv();tone('triangle',760*p,520,.16,.35);tone('square',1180*p,900,.09,.15);noise('bandpass',1800,900,.08,.4,0,3);tone('sine',120,60,.1,.5)},
 dodge:()=>noise('bandpass',900,3200,.2,.35,0,2),
 sup:()=>{tone('sawtooth',90,900,.6,.45);tone('square',180,1800,.6,.15);noise('highpass',400,6000,.6,.3)},
 crowd:()=>{noise('bandpass',500,1100,1.2,.22,0,.7);noise('bandpass',900,1800,1,.12,.1,.7)},
 boom:()=>{tone('sine',110,24,.8,1.4);noise('lowpass',3000,120,.6,1);tone('sawtooth',300,40,.4,.4)},
 win:()=>[261,329,392,523,659].forEach((f,i)=>{tone('triangle',f,f*1.002,.4,.3,i*.11);tone('sine',f*2,f*2.004,.3,.1,i*.11)})};
/* ---------- state ---------- */
const COLORS=['#ffffff','#fef3c7','#fecdd3','#bbf7d0','#bae6fd','#e9d5ff','#fef08a','#334155','#f43f5e','#a3e635'];
const EXPR=[['smiley','🙂'],['angry','😡'],['silly','😜'],['cool','😎'],['shocked','😲'],['happy','😆'],['wink','😉'],['derp','🥴']];
const HATS=[['none','None'],['tophat','🎩 Top hat'],['horns','😈 Horns'],['crown','👑 Crown'],['party','🎉 Party'],['halo','😇 Halo'],['bunny','🐰 Bunny'],['wizard','🧙 Wizard'],['cowboy','🤠 Cowboy'],['phones','🎧 Phones'],['mohawk','🤘 Mohawk'],['antenna','👽 Antenna']];
const SHIRTS=['','tee','tank','hoodie','armor','striped','star','heart','skull','lightning','flame','cape-shirt'];
const SHIRT_LABELS={'':'None',tee:'👕 Tee',tank:'🎽 Tank',hoodie:'🧥 Hoodie',armor:'🛡 Armor',striped:'🦓 Striped',star:'⭐ Star',heart:'💖 Heart',skull:'💀 Skull',lightning:'⚡ Lightning',flame:'🔥 Flame','cape-shirt':'🦸 Cape Shirt'};
const SHIRT_COLORS=['#ffffff','#f43f5e','#3b82f6','#facc15','#22c55e','#111827','#a855f7','#f97316','#ec4899','#06b6d4'];
const ARENAS={cyber:['CYBERPUNK','#030712','#0f172a','#38bdf8'],colo:['COLOSSEUM','#451a03','#d97706','#fef3c7'],grid:['VR GRID','#020617','#082f49','#38bdf8'],roof:['ROOFTOP','#1e1b4b','#334155','#f59e0b'],space:['SPACE','#0b0720','#1e1b4b','#a78bfa',1],lava:['LAVA PIT','#2a0a05','#431407','#f97316',1],snow:['SNOWY PEAK','#bae6fd','#f8fafc','#e0f2fe',1],candy:['CANDY LAND','#fbcfe8','#fde68a','#f472b6',1]};
const DIFF={easy:{react:.3,atk:.45,dmg:.8,tick:.5},normal:{react:.55,atk:.65,dmg:1,tick:.32},hard:{react:.8,atk:.85,dmg:1.15,tick:.2}};
const BOTS=[{n:'INK BOT',s:'ink',c:'#fee2e2',e:'angry',h:'horns',hs:1.05,bs:1,m:{tick:1,atk:1,dmg:1,react:1},shirt:'tank',shirtColor:'#111827'},
{n:'ZIPPY',s:'combo',c:'#e0f2fe',e:'cool',h:'bunny',hs:1,bs:.9,m:{tick:.6,atk:1.1,dmg:.85,react:1.1},shirt:'tee',shirtColor:'#3b82f6'},
{n:'BRUISER',s:'slam',c:'#fef08a',e:'shocked',h:'tophat',hs:1.1,bs:1.35,m:{tick:1.3,atk:.9,dmg:1.45,react:.7},shirt:'armor',shirtColor:'#9ca3af'},
{n:'SHADOW',s:'tele',c:'#334155',e:'cool',h:'none',hs:1,bs:1,m:{tick:.5,atk:1,dmg:1,react:1.3},shirt:'hoodie',shirtColor:'#111827'},
{n:'KING DOODLE',s:'royal',c:'#f3e8ff',e:'smiley',h:'crown',hs:1.15,bs:1.15,m:{tick:.7,atk:1.2,dmg:1.2,react:1.2},shirt:'cape-shirt',shirtColor:'#a855f7'},
{n:'GHOST',s:'ghost',c:'#e2e8f0',e:'shocked',h:'halo',hs:1.1,bs:.9,m:{tick:.8,atk:.9,dmg:1,react:1.1},shirt:'',shirtColor:'#ffffff'},
{n:'ROBO',s:'robo',c:'#94a3b8',e:'angry',h:'antenna',hs:1,bs:1.2,m:{tick:.55,atk:1.1,dmg:1.1,react:1.1},shirt:'armor',shirtColor:'#64748b'}];
const mix=()=>{const d=DIFF[G.diff],m=G.bot.m;return{react:Math.min(.95,d.react*m.react),atk:Math.min(.95,d.atk*m.atk),dmg:d.dmg*m.dmg,tick:d.tick*m.tick}};
