#ink{position:absolute;inset:0;z-index:6;pointer-events:none;opacity:0;transition:opacity .3s;background:radial-gradient(circle at 20% 30%,#000 0 12%,transparent 13%),radial-gradient(circle at 72% 58%,#000 0 17%,transparent 18%),radial-gradient(circle at 45% 78%,#000 0 10%,transparent 11%),radial-gradient(circle at 85% 20%,#000 0 8%,transparent 9%)}
#vig{position:absolute;inset:0;pointer-events:none;z-index:4;background:radial-gradient(ellipse at center,transparent 58%,rgba(0,0,0,.5))}#vig.low{box-shadow:inset 0 0 90px rgba(239,68,68,.65);animation:lw .7s infinite alternate}@keyframes lw{to{box-shadow:inset 0 0 150px rgba(239,68,68,.95)}}
#vs{position:absolute;left:0;right:0;top:34%;text-align:center;z-index:9;pointer-events:none;font-family:'Permanent Marker';font-size:30px;text-shadow:0 4px 0 #000;opacity:0}#vs.show{animation:vsa 1.5s forwards}@keyframes vsa{0%{opacity:0;transform:scale(2)}15%{opacity:1;transform:scale(1)}80%{opacity:1}100%{opacity:0;transform:scale(1.1)}}#vs b{color:#fbbf24;margin:0 8px}
.sw{display:inline-flex;align-items:center;justify-content:center}.sw.lk{opacity:.5}.sw.lk::after{content:'🔒';font-size:13px}.opt.lk{opacity:.6}.pd{outline:2px solid var(--amber)}#toast{position:fixed;left:50%;top:18%;transform:translateX(-50%);background:#0f172a;border:1px solid var(--amber);border-radius:12px;padding:8px 14px;z-index:40;opacity:0;transition:opacity .2s;pointer-events:none;font-weight:700}
#flash{position:absolute;inset:0;pointer-events:none;z-index:7;opacity:0;background:#f59e0b}
#flash.f{animation:fl .5s}@keyframes fl{from{opacity:.7}to{opacity:0}}
