function emote(f,n,d,force){if(G.online||f.em||f.ko)return;if(G.mode==='match'&&!force&&!canAct(f))return;f.em={n,t:0,d:d||1.4};f.punch=0;f.pend=null;f.block=false;SFX.dodge();ring(f.x,1,0,0xe879f9,3,.5)}
function emAnim(f,dt,t){const e=f.em,r=f.root,n=e.n,hl=f.hl.position,hr=f.hr.position;e.t+=dt/e.d;
 if(e.t>=1){f.em=null;r.rotation.set(0,0,0);r.position.y=0;r.scale.setScalar(.65);f.head.rotation.set(0,0,0);return}
 const u=e.t,s=Math.sin(u*Math.PI),w=Math.sin(t*10);f.head.rotation.set(0,0,0);r.rotation.set(0,0,0);r.position.y=0;r.scale.setScalar(.65);
 const up=()=>{hl.set(0,1.9,.8);hr.set(0,1.9,-.8)};
 if(n==='wave'){hr.set(0,2.05,-.7+Math.sin(t*18)*.3);hl.set(0,1.3,.45);f.head.rotation.z=Math.sin(t*6)*.12}
 else if(n==='flex'){up();r.scale.setScalar(.65*(1+.08*s))}
 else if(n==='i_classic'){up();r.rotation.y=Math.sin(u*Math.PI*2)*.5;r.scale.setScalar(.65*(1+.08*s));if(u<.06)ring(f.x,.05,0,0xfbbf24,3,.5,true)}
 else if(n==='dance'){r.rotation.y=w*.6;r.position.y=Math.abs(w)*.25;hl.set(0,1.8+w*.4,.7);hr.set(0,1.8-w*.4,-.7);f.head.rotation.z=w*.2}
 else if(n==='spin'){r.rotation.y=u*Math.PI*4;r.position.y=s*.4;hl.set(0,1.4,.95);hr.set(0,1.4,-.95)}
 else if(n==='flip'){r.rotation.x=-u*Math.PI*2;r.position.y=s*1.3;hl.set(0,.9,.5);hr.set(0,.9,-.5)}
 else if(n==='rage'){r.rotation.z=Math.sin(t*50)*.06;hl.set(0,.9,.6+Math.sin(t*30)*.1);hr.set(0,.9,-.6-Math.sin(t*30)*.1);f.mat.emissive.setRGB(.6+.3*Math.sin(t*20),0,0);if(Math.random()<.4)blob(f.x,.1,0,0xef4444,.15,.4,3)}
 else if(n==='i_strut'){r.rotation.z=Math.sin(t*6)*.1;r.position.y=Math.abs(Math.sin(t*6))*.15;hl.set(.3,1.1,.75);hr.set(.3,1.1,-.75);if(u>.7)up()}
 else if(n==='i_drop'){const a=Math.min(1,u/.55);r.position.y=u<.55?Math.pow(1-a,2)*9:Math.max(0,Math.sin((u-.55)*20)*.5*(1-u));up();
  if(u>=.55&&!e.x){e.x=1;impact(f.x,0xfbbf24,true);shake(.5);SFX.boom();burst(f.x,0xfbbf24,30)}}
 else if(n==='i_ninja'){const k=Math.min(1,u*2.2);r.scale.setScalar(.65*Math.max(.01,k));r.rotation.y=(1-k)*14;hl.set(0,1.2,.35);hr.set(0,1.2,-.35);
  if(u<.5&&Math.random()<.8)blob(f.x+(Math.random()-.5)*1.4,.4+Math.random()*1.4,(Math.random()-.5)*.6,0x64748b,.3,.6,1.5)}
 else if(n==='i_thunder'){if(u<.35&&Math.random()<.3)ring(f.x,.05,0,0xfde047,2,.3,true);
  if(u>.35&&!e.x){e.x=1;bolt(f.x,0xfde047);bolt(f.x,0xffffff);bolt(f.x+.2,0xfde047);impact(f.x,0xfde047,true);SFX.boom();shake(.4);const q=$('flash');q.classList.remove('f');void q.offsetWidth;q.classList.add('f')}
  const g=u>.35?Math.max(0,1-u)*.9:0;f.mat.emissive.setRGB(g,g*.85,0);up();r.position.y=u>.35?s*.2:0}}
function wheel(){const w=$('emw');if(!w.classList.contains('hide')){w.classList.add('hide');return}w.innerHTML='';
 EMOTES.filter(x=>open('emo',x[0])).forEach(([k,l])=>{const b=document.createElement('button');b.className='c';b.innerHTML='<span>'+l.split(' ')[0]+'</span>'+k.toUpperCase();b.onpointerdown=e=>{e.preventDefault();emote(P,k);w.classList.add('hide')};w.appendChild(b)});w.classList.remove('hide')}
$('kT').onpointerdown=e=>{e.preventDefault();wheel()};
addEventListener('keydown',e=>{if(G.mode!=='match'||G.paused)return;const i=+e.key;if(i>=1){const o=EMOTES.filter(x=>open('emo',x[0]));if(o[i-1])emote(P,o[i-1][0])}});

/* ---------- intros ---------- */
const ICAM={c:new THREE.Vector3(0,2,4.8),l:new THREE.Vector3(0,.5,0)};let icTok=0;
function card(n,sub,col,side){const e=document.createElement('div');e.className='nc '+side;e.style.setProperty('--c',col);e.textContent=n;const s=document.createElement('small');s.textContent=sub;e.appendChild(s);document.body.appendChild(e);setTimeout(()=>e.remove(),1700)}
function intro(){if(G.online)return;const tk=++icTok,pi=G.pc.intro||'classic',oi=rnd(Object.keys(ILAB)),at=(ms,fn)=>setTimeout(()=>{if(tk===icTok)fn()},ms);
 G.intro=3.3;G.icam=1;ICAM.c.set(P.x+.8,1.5,3.2);ICAM.l.set(P.x,1.4,0);card(G.pn,ILAB[pi],'#10b981','l');emote(P,'i_'+pi,1.4,1);
 at(1350,()=>{ICAM.c.set(O.x-.8,1.5,3.2);ICAM.l.set(O.x,1.4,0);card(G.bn,ILAB[oi],'#f43f5e','r');emote(O,'i_'+oi,1.4,1)});
 at(2700,()=>{ICAM.c.set(0,2,4.8);ICAM.l.set(0,.5,0)});
 at(3300,()=>{G.icam=0;text('FIGHT!');say('Fight!')})}
const _sm=startMatch;window.startMatch=function(){_sm.apply(this,arguments);intro()};
const _tx=text;window.text=function(t,...a){if(t==='FIGHT!'&&G.icam)return;return _tx.call(this,t,...a)};
const _sy=say;window.say=t=>{if(t==='Fight!'&&G.icam)return;_sy(t)};
const _hud=hud;window.hud=function(){if(G.icam)G.time=99;_hud();if(G.icam){camTo.copy(ICAM.c);lookTo.copy(ICAM.l)}};

/* ---------- pickup weapons (every 20s) ---------- */
const WEAP={bat:{b:7,u:6,n:'BAT'},hammer:{b:13,u:3,n:'HAMMER'},pan:{b:6,u:8,n:'FRYING PAN'},banana:{b:4,u:10,n:'BANANA'},sword:{b:10,u:5,n:'SWORD'},anvil:{b:20,u:2,n:'ANVIL'}};
let wk=null,wkT=20;
function wpMesh(k){const g=new THREE.Group(),M=c=>new THREE.MeshStandardMaterial({color:c,roughness:.5,metalness:.2}),C=THREE.CylinderGeometry,B=THREE.BoxGeometry,a=(geo,c,x,y,z,rx)=>{const o=new THREE.Mesh(geo,M(c));o.position.set(x,y,z);if(rx)o.rotation.x=rx;o.castShadow=true;g.add(o)};
 if(k==='bat')a(new C(.08,.14,1.1,10),0xb45309,0,.5,0);
 else if(k==='hammer'){a(new C(.05,.05,1,8),0x78350f,0,.5,0);a(new B(.5,.3,.3),0x9ca3af,0,1.05,0)}
 else if(k==='pan'){a(new C(.04,.04,.7,8),0x374151,0,.35,0);a(new C(.3,.3,.06,18),0x1f2937,0,.95,0,Math.PI/2)}
 else if(k==='banana')a(new THREE.TorusGeometry(.4,.1,8,16,Math.PI),0xfacc15,0,.4,0);
 else if(k==='sword'){a(new B(.08,1.1,.04),0xe5e7eb,0,.85,0);a(new B(.4,.07,.1),0xf59e0b,0,.3,0);a(new C(.04,.04,.3,8),0x78350f,0,.12,0)}
 else{a(new B(.8,.3,.5),0x374151,0,.8,0);a(new B(.4,.3,.3),0x374151,0,.5,0);a(new B(.6,.15,.45),0x1f2937,0,.3,0)}
 return g}
function dropWp(f,brk){if(f.wm){f.hl.remove(f.wm);f.wm=null}if(f.wp&&brk){text('BROKE!');burst(f.x,0xfbbf24,25)}f.wp=null}
function take(f,k){const w=WEAP[k];dropWp(f);f.wp={k,b:w.b,u:w.u};const m=wpMesh(k);m.rotation.x=.6;f.hl.add(m);f.wm=m;f.hand=1;text('GOT '+w.n+'!');burst(f.x,0xffffff,20);ring(f.x,1,0,0xffffff,3,.4);SFX.dodge()}
function wkClear(){if(wk){scene.remove(wk.m);wk=null}wkT=20;[P,O].forEach(f=>dropWp(f))}
function wkTick(dt,t){if(G.mode!=='match'||G.over||G.paused||G.online||G.intro>0)return;
 wkT-=dt;if(wkT<=0){wkT=20;if(wk)scene.remove(wk.m);const k=rnd(Object.keys(WEAP)),m=wpMesh(k),x=(Math.random()*2-1)*8;m.scale.setScalar(.9);m.position.set(x,.8,0);scene.add(m);ring(x,.05,0,0xffffff,2.5,.6,true);text('📦 '+WEAP[k].n+'!');wk={k,m,x}}
 if(wk){wk.m.position.y=.8+Math.sin(t*4)*.15;wk.m.rotation.y=t*2.5;wk.m.rotation.z=.4;for(const f of[P,O])if(!f.wp&&Math.abs(f.x-wk.x)<.8&&!f.jump&&!f.air){take(f,wk.k);scene.remove(wk.m);wk=null;break}}}
const _damage=damage;window.damage=function(f,t,d,txt,blocked){if(!blocked&&t.em){t.em=null;t.root.rotation.set(0,0,0)}
 if(f.wp&&!blocked&&(txt==='POW!'||txt==='WHAM!')){d+=f.wp.b;ring((f.x+t.x)/2,1.2,0,0xffffff,4,.3);if(--f.wp.u<=0)dropWp(f,1)}return _damage.call(this,f,t,d,txt,blocked)};
const _punch=punch;window.punch=function(f,k,...a){const r=_punch.call(this,f,k,...a);if(f.wp&&k!=='s'&&f.punch)f.hand=1;return r};
const _ca=canAct;window.canAct=f=>!f.em&&_ca(f);
const _ai=ai;window.ai=function(dt){if(G.intro>0)return;if(wk&&G.mode==='match'&&!G.over&&!O.wp&&canAct(O)&&Math.random()<dt*3){O.tx=wk.x;aiMv=.8}
 _ai(dt);if(G.mode==='match'&&!G.online&&dist()>3&&Math.random()<dt*.15&&canAct(O))emote(O,rnd(['wave','flex','dance','spin']))};
const _anim=anim;window.anim=function(f,dt,t){if(f===P)wkTick(dt,t);
 if(f.em){const dir=f===P?(P.x<O.x?1:-1):(O.x<P.x?1:-1);if(G.mode==='match')f.ry=dir*Math.PI/2;f.g.rotation.y+=(f.ry-f.g.rotation.y)*Math.min(1,15*dt);f.x+=(f.tx-f.x)*Math.min(1,12*dt);f.g.position.x=f.x;emAnim(f,dt,t);limbs(f);return}
 return _anim(f,dt,t)};
const _rf=resetFighters;window.resetFighters=function(){wkClear();return _rf.apply(this,arguments)};
const _tl=toLobby;window.toLobby=function(){wkClear();icTok++;G.icam=0;return _tl.apply(this,arguments)};
$('bMenu').onclick=$('bQuit').onclick=window.toLobby;

/* ---------- vault (password-locked bot code) ---------- */
const vmsg=t=>$('vmsg').innerText=t,b64=a=>btoa(String.fromCharCode(...a)),ub=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
async function vkey(pw,salt){const k=await crypto.subtle.importKey('raw',new TextEncoder().encode(pw),'PBKDF2',false,['deriveKey']);return crypto.subtle.deriveKey({name:'PBKDF2',salt,iterations:150000,hash:'SHA-256'},k,{name:'AES-GCM',length:256},false,['encrypt','decrypt'])}
async function vSave(){const pw=$('vpw').value;if(pw.length<4)return vmsg('Use a password of 4+ characters');
 try{const salt=crypto.getRandomValues(new Uint8Array(16)),iv=crypto.getRandomValues(new Uint8Array(12)),data=new TextEncoder().encode(JSON.stringify({W,pc:G.pc,st:getStat()})),ct=new Uint8Array(await crypto.subtle.encrypt({name:'AES-GCM',iv},await vkey(pw,salt),data));
  $('vcode').value=b64([...salt,...iv,...ct]);vmsg('Locked! Copy the code or link to your other device.')}catch(e){vmsg('Needs a secure (https) page')}}
async function vLoad(){try{const u=ub($('vcode').value.trim()),o=JSON.parse(new TextDecoder().decode(await crypto.subtle.decrypt({name:'AES-GCM',iv:u.slice(16,28)},await vkey($('vpw').value,u.slice(0,16)),u.slice(28))));
  W.c=o.W.c|0;W.own=o.W.own||{};saveW();Object.assign(G.pc,o.pc);G.pc.name=String(G.pc.name||'').replace(/[<>]/g,'').slice(0,12);for(const k in DEF)if(!open(k,G.pc[k]))G.pc[k]=DEF[k];
  try{localStorage.setItem('db_pc',JSON.stringify(G.pc));localStorage.setItem('db_st',JSON.stringify(o.st))}catch(e){}build('p');sync();showStat();vmsg('Bot loaded! 🎉')}catch(e){vmsg('Wrong password or bad code')}}
$('bVault').onclick=()=>$('vault').classList.remove('hide');$('vClose').onclick=()=>$('vault').classList.add('hide');$('vSave').onclick=vSave;$('vLoad').onclick=vLoad;
$('vCopy').onclick=()=>{const c=$('vcode').value;if(!c)return vmsg('Tap LOCK first');(navigator.clipboard?navigator.clipboard.writeText(location.href.split('#')[0]+'#v='+c):Promise.reject()).then(()=>vmsg('Link copied!'),()=>{$('vcode').select();vmsg('Copy the code manually')})};
if(location.hash.indexOf('#v=')===0){$('vcode').value=location.hash.slice(3);$('vault').classList.remove('hide');vmsg('Enter your password, then tap UNLOCK')}
})();
</script>
