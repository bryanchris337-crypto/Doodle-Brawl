.pow{position:absolute;font-family:'Permanent Marker';font-size:46px;color:var(--amber);text-shadow:3px 3px 0 #000,-2px -2px 0 #000;animation:pw .6s forwards}
@keyframes pw{0%{transform:scale(.2) rotate(-15deg);opacity:0}35%{transform:scale(1.3) rotate(6deg);opacity:1}100%{transform:scale(.9) translateY(-30px);opacity:0}}
